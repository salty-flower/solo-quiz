{
  "name": "solo-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "vite": "cross-env node_modules/vite/bin/vite.js",
    "dev": "pnpm run vite",
    "build:standalone": "cross-env BUILD_TARGET=inline pnpm run vite build",
    "build:cdn": "cross-env BUILD_TARGET=cdn pnpm run vite build",
    "build:schema": "node scripts/generate-schema.ts",
    "build": "pnpm run build:standalone && pnpm run build:cdn && pnpm run build:schema",
    "preview": "pnpm run vite preview",
    "format": "biome format . --write",
    "lint": "biome lint . --write",
    "typecheck": "tsc --noEmit",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.app.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run svelte-check",
    "test": "vitest",
    "test:examples": "node scripts/test-examples.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.71.0",
    "@tailwindcss/vite": "^4.3.5",
    "idb": "^8.0.4",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tsconfig/svelte": "^5.0.8",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "jsdom": "^31.0.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
